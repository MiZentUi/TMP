<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LR13_14.UI.ViewModels.Pages"
             xmlns:conv="using:LR13_14.UI.ValueConverters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="1200"
             x:DataType="vm:RoomsViewModel"
             x:Class="LR13_14.UI.Views.Pages.RoomsView"
             Name="UserControl">

    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Loaded" SourceObject="UserControl">
            <ia:InvokeCommandAction Command="{Binding UpdateCategoriesListCommand}" />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <UserControl.Resources>
        <conv:CostToBrushConverter x:Key="costToBrushConverter"/>
        <conv:ServiceIdToImageConverter x:Key="serviceIdToImageConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="10,10">
            <Button DockPanel.Dock="Right"
                    Margin="5"
                    CornerRadius="10"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Padding="10"
                    Command="{Binding AddCategoryCommand}"
                    CommandParameter="{Binding}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
                    </Style>
                </Button.Styles>
                <TextBlock Text="+"/>
            </Button>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      HorizontalAlignment="Stretch"
                      Margin="5"
                      Padding="15"
                      Foreground="Black"
                      Background="#eeeeee"
                      BorderBrush="Black"
                      CornerRadius="10"
                      Name="ComboBox">
                <i:Interaction.Behaviors>
                    <ia:EventTriggerBehavior EventName="SelectionChanged">
                        <ia:InvokeCommandAction Command="{Binding UpdateMembersListCommand}" />
                    </ia:EventTriggerBehavior>
                </i:Interaction.Behaviors>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Name}"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="20,10">
            <TextBlock Grid.Row="0" Grid.Column="0">Rooms count</TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1" TextAlignment="Right" Text="{Binding SelectedCategory.RoomsCount}"/>
            <TextBlock Grid.Row="1" Grid.Column="0">Stars count</TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1" TextAlignment="Right" Text="{Binding SelectedCategory.StarsCount}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Services}"
                      Margin="15,10"
                      Foreground="Black"
                      Background="Transparent">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,10,0,0"
                            CornerRadius="10"
                            HorizontalContentAlignment="Stretch"
                            BorderBrush="{Binding Cost, Converter={StaticResource costToBrushConverter}}" BorderThickness="1"
                            Padding="10"
                            Command="{Binding $parent[UserControl].DataContext.ShowDetailsCommand}"
                            CommandParameter="{Binding}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
                                <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
                            </Style>
                        </Button.Styles>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Height="75" Width="75" Source="{Binding Id, Converter={StaticResource serviceIdToImageConverter}}"/>
                            <TextBlock Margin="10" Foreground="{Binding Cost, Converter={StaticResource costToBrushConverter}}" Text="{Binding Data.Name}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Margin="15,5"
                CornerRadius="10"
                BorderBrush="Black"
                BorderThickness="1"
                Padding="10"
                Command="{Binding AddServiceCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding IsAddServiceButton}">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
                </Style>
            </Button.Styles>
            <TextBlock Text="+"/>
        </Button>
    </StackPanel>
</UserControl>
